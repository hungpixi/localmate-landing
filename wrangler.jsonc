{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "localmate-landing",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "<D1_DATABASE_NAME_DEV>",
      "database_id": "<D1_DATABASE_ID_DEV>",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "localmate-landing-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "<D1_DATABASE_NAME_STAGING>",
          "database_id": "<D1_DATABASE_ID_STAGING>",
          "migrations_dir": "./migrations"
        }
      ]
    },
    "production": {
      "name": "localmate-landing-production",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "<D1_DATABASE_NAME_PRODUCTION>",
          "database_id": "<D1_DATABASE_ID_PRODUCTION>",
          "migrations_dir": "./migrations"
        }
      ]
    }
  }
}
